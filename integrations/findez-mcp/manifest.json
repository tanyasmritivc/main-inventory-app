{
  "manifest_version": "0.3",
  "name": "findez-inventory",
  "display_name": "FindEZ inventory",
  "version": "1.1.0",
  "description": "Manage authorized FindEZ inventory, organization resources and access. Permanent deletion requires human confirmation in FindEZ.",
  "author": {
    "name": "FindEZ",
    "email": "info@findez.ai",
    "url": "https://findez.ai"
  },
  "homepage": "https://findez.ai",
  "documentation": "https://findez.ai/docs/api#ai-assistants",
  "privacy_policies": [
    "https://findez.ai/privacy"
  ],
  "server": {
    "type": "node",
    "entry_point": "server/index.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.mjs"
      ],
      "env": {
        "FINDEZ_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "tools_generated": true,
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=20.10.0"
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "FindEZ API key",
      "description": "Create an organization key in FindEZ Settings > API keys. Enable directory, item, structure and member permissions as needed. Deletion scopes are opt-in and require human review.",
      "sensitive": true,
      "required": true
    }
  }
}
