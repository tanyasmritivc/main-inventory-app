{
  "name": "findez-desktop",
  "productName": "FindEZ",
  "version": "0.1.0",
  "private": true,
  "description": "FindEZ inventory, CAD Intelligence and Ask on your desktop",
  "author": {
    "name": "FindEZ",
    "email": "info@findez.ai"
  },
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
