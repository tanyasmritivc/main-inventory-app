      "value"
    ],
    "title": "InventoryFilter"
  },
  "InventoryQuery": {
    "properties": {
      "resource": {
        "type": "string",
        "const": "items",
        "title": "Resource",
        "default": "items"
      },
      "workspace_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ],
