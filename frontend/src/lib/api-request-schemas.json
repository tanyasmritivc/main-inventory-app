  "InventoryFilter": {
    "properties": {
      "field": {
        "type": "string",
        "enum": [
          "name",
          "category",
          "location",
          "brand",
          "part_number",
          "barcode",
          "quantity",
          "source_system",
          "external_id"
        ],
        "title": "Field"
      },
      "op": {
        "type": "string",
        "enum": [
          "eq",
          "neq",
          "gt",
          "gte",
          "lt",
          "lte"
        ],
        "title": "Op",
        "default": "eq"
      },
      "value": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ],
        "title": "Value"
      }
    },
