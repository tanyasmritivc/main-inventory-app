# FastAPI
ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
# NEVER set when running against cloud Supabase. Only meaningful for a backend running
# against a self-hosted stack, which signs HS256 with a shared JWT_SECRET. Keep empty on cloud.
SUPABASE_JWT_SECRET=

# Public integration API (per API key)
API_KEY_REQUESTS_PER_MINUTE=120
API_KEY_BULK_REQUESTS_PER_MINUTE=10
API_KEY_BULK_MAX_ITEMS=500
SUPABASE_STORAGE_BUCKET=item-images
SUPABASE_STORAGE_PUBLIC=true
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=3600

# FindEZ agent gateway. Keep the key server-side.
FINDEZ_AGENT_KEY=
FINDEZ_AGENT_BASE_URL=https://agent.ftctools.com/v1
FINDEZ_AGENT_MODEL=deepseek-v4-flash-agent
FINDEZ_AGENT_TIMEZONE=America/Los_Angeles

# Limits
MAX_IMAGE_MB=10

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Run scripts/stripe_setup.py once to create products/prices and get these IDs:
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_SEASON=
# Frontend base URL (used for Stripe success/cancel/portal return URLs)
FRONTEND_URL=https://www.findez.ai
