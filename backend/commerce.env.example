# Independent one-time Amazon CSV/ZIP imports (no OAuth credentials needed).
FINDEZ_COMMERCE_PURCHASE_IMPORT_ENABLED=false
# Server only. Disabled until migration, provider setup and live acceptance.
FINDEZ_COMMERCE_ENABLED=false
FINDEZ_COMMERCE_ENCRYPTION_KEY=
FINDEZ_COMMERCE_SHOPIFY_CLIENT_ID=
FINDEZ_COMMERCE_SHOPIFY_CLIENT_SECRET=
# Register the HTTPS frontend callback implemented by the web lane.
FINDEZ_COMMERCE_SHOPIFY_REDIRECT_URI=https://www.findez.ai/connect/shopify/callback
FINDEZ_COMMERCE_AMAZON_CLIENT_ID=
FINDEZ_COMMERCE_AMAZON_CLIENT_SECRET=
FINDEZ_COMMERCE_AMAZON_APPLICATION_ID=
FINDEZ_COMMERCE_AMAZON_REDIRECT_URI=https://www.findez.ai/connect/amazon/callback
FINDEZ_COMMERCE_AMAZON_DRAFT=true
# Personal Amazon purchases through user-authorized Gmail (independent feature).
FINDEZ_COMMERCE_GMAIL_ENABLED=false
FINDEZ_COMMERCE_GMAIL_CLIENT_ID=
FINDEZ_COMMERCE_GMAIL_CLIENT_SECRET=
FINDEZ_COMMERCE_GMAIL_REDIRECT_URI=https://www.findez.ai/connect/gmail/callback
