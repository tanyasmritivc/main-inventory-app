{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "myagent": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "myagent",
      "options": {
        "baseURL": "https://agent-gateway.openstack.ftctools.com/codingagent/v1",
        "apiKey": "{env:MYAGENT_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash-coding": { "name": "deepseek-v4-flash-coding" }
      }
    }
  },
  "mcp": {
    "findez": {
      "type": "local",
      "command": [
        "node",
        "integrations/findez-mcp/src/stdio.mjs"
      ],
      "cwd": ".",
      "environment": {
        "FINDEZ_API_KEY": "{env:FINDEZ_API_KEY}"
      },
      "enabled": true,
      "timeout": 10000
    }
  }
}
